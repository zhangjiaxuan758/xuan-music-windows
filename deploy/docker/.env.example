# 当前文件：Xuan Docker Compose 的用户配置模板。
XUAN_IMAGE_NAMESPACE=papersman

XUAN_HTTP_BIND=0.0.0.0
XUAN_HTTP_PORT=18080
XUAN_AI_PROVIDER=google
XUAN_FORWARD_CLIENT_IP=false
ENABLE_GENERAL_UNBLOCK=false

GEMINI_API_KEY=
OPENAI_API_KEY=
OPENAI_API_URL=https://api.openai.com/v1
OPENAI_API_MODEL=gpt-4o
OPENAI_API_TEMPERATURE=0.7

XUAN_SYNC_BIND=0.0.0.0
XUAN_SYNC_PORT=13000
XUAN_SYNC_DATA_DIR=./data/sync
SYNC_TOKEN=
DASHBOARD_TOKEN=
